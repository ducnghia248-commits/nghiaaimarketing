# ============================================================
# FPT TELECOM – PLAY & WIN — cấu hình môi trường
# Sao chép file này thành .env.local (local) hoặc khai báo trên server.
# ============================================================

# Khóa bí mật ký phiên người chơi/admin (>= 32 ký tự ngẫu nhiên). BẮT BUỘC ở production.
APP_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# --- Cơ sở dữ liệu ---
# Để trống DATABASE_URL => dùng PostgreSQL nhúng (PGlite) lưu tại PGLITE_DIR, không cần cài đặt gì.
# Production: trỏ tới PostgreSQL thật, ví dụ:
# DATABASE_URL=postgres://user:password@host:5432/playwin
DATABASE_URL=
# Bật SSL khi PostgreSQL yêu cầu (Supabase, Neon, RDS...)
DATABASE_SSL=false
PGLITE_DIR=./.data/pglite

# --- Tài khoản quản trị (tự tạo khi khởi động nếu chưa tồn tại) ---
# Vai trò admin: toàn quyền, xem được dữ liệu khách hàng.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
# Vai trò editor (tùy chọn): quản lý game/câu hỏi/hình ảnh/thống kê, KHÔNG xem dữ liệu khách hàng.
EDITOR_USERNAME=
EDITOR_PASSWORD=

# Đặt true khi chạy sau HTTPS (production) để cookie chỉ gửi qua HTTPS.
COOKIE_SECURE=false
